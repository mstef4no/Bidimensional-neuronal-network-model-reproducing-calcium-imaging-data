TITLE Hippocampal HH channelsINDEPENDENT {t FROM 0 TO 1 WITH 1 (ms)}NEURON {	SUFFIX hh2        NONSPECIFIC_CURRENT ina        NONSPECIFIC_CURRENT ik	RANGE gnabar, gkbar, vtraub, ek, ena }UNITS {	(mA) = (milliamp)	(mV) = (millivolt)}PARAMETER {	ena     = 50    (mV)	ek      = -100   (mV)	gnabar  = .05  (mho/cm2)	gkbar   = .005  (mho/cm2)	vtraub  = -55   (mV)}STATE {	m h n}ASSIGNED {	v	(mV)	ina     (mA/cm2)	ik      (mA/cm2)}BREAKPOINT {	SOLVE states METHOD cnexp	ina = gnabar * m*m*m*h * (v - ena)	ik  = gkbar * n*n*n*n * (v - ek)}INITIAL {	m = m_inf(v)	h = h_inf(v)	n = n_inf(v)}DERIVATIVE states {       m' = (m_inf(v) - m) / tau_m(v)       h' = (h_inf(v) - h) / tau_h(v)       n' = (n_inf(v) - n) / tau_n(v)}FUNCTION m_inf(v(mV)) {        LOCAL a,b,v2,x,y       UNITSOFF:       v2 = v-vtraub:       x=(v2-13):       y=4:       if(fabs(x/y)>1e-6){:       a = 0.32 * x / ( 1 - exp(-x/y)):       } else {:       a = 0.32 * y/(1-x/(2*y)):       }:       x=(v2-40):       y=5:      if(fabs(x/y)>1e-6){:       b = -0.28 * x / ( 1 - exp(x/y)):      } else {:      b = -0.28 * y/(-1-x/(2*y)):      }:	m_inf = a / (a + b)	a=(-0.32*(v-vtraub-13.0))/(exp(-(v-vtraub-13.0)/4.0)-1.0)	b=(0.28*(v-vtraub-40.0))/(exp((v-vtraub-40.0)/5.0)-1.0)	m_inf=a/(a+b) 	UNITSON}FUNCTION tau_m(v(mV)) {   LOCAL a,b,v2,x,y  UNITSOFF:  v2 = v-vtraub:  x=(v2-13):  y=4:  if(fabs(x/y)>1e-6){:  a = 0.32 * x/(1-exp(-x/y)):  } else {:  a = 0.32 * y/(1-x/(2*y)):  }:  x=(v2-40):  y=5:  if(fabs(x/y)>1e-6){:  b = -0.28 * x / ( 1 - exp(x/y)):  } else {:  b = -0.28 * y/(-1-x/(2*y)): }  a=(-0.32*(v-vtraub-13.0))/(exp(-(v-vtraub-13.0)/4.0)-1.0)  b=(0.28*(v-vtraub-40.0))/(exp((v-vtraub-40.0)/5.0)-1.0)	  tau_m = 1/(a + b)  UNITSON}FUNCTION h_inf(v(mV)) {        LOCAL a,b,v2	UNITSOFF:	v2 = v-vtraub:	a = 0.128 * exp((17-v2)/18):	b = 4 / ( 1 + exp((40-v2)/5) )	a=0.128*exp(-(v-vtraub-17.0)/18.0)	b=4.0/(1.0+exp(-(v-vtraub-40.0)/5.0))	h_inf = a / (a + b)	UNITSON}FUNCTION tau_h(v(mV)) {        LOCAL a,b,v2	UNITSOFF:	v2 = v-vtraub:	a = 0.128 * exp((17-v2)/18):	b = 4 / ( 1 + exp((40-v2)/5) )	a=0.128*exp(-(v-vtraub-17.0)/18.0)	b=4.0/(1.0+exp(-(v-vtraub-40.0)/5.0))	tau_h = 1 / (a + b)	UNITSON}FUNCTION n_inf(v(mV)) {        LOCAL a,b,v2,x,y	UNITSOFF:	v2 = v-vtraub:       x=(v2-15):       y=5:       if(fabs(x/y)>1e-6){:       a = 0.032 * x / ( 1 - exp(-x/y)):       } else {:       a = 0.032 * y/(1-x/(2*y)):       }:       b = 0.5 * exp((10-v2)/40)	a=(-0.032*(v-vtraub-15.0))/(exp(-(v-vtraub-15.0)/5.0)-1.0)	b=0.5*exp(-(v-vtraub-10.0)/40.0)	n_inf = a / (a + b)	UNITSON}FUNCTION tau_n(v(mV)) {        LOCAL a,b,v2,x,y	UNITSOFF:	v2 = v-vtraub:       x=(v2-15):       y=5:       if(fabs(x/y)>1e-6){:       a = 0.032 * x / ( 1 - exp(-x/y)):       } else {:       a = 0.032 * y/(1-x/(2*y)):       }:       b = 0.5 * exp((10-v2)/40)	a=(-0.032*(v-vtraub-15.0))/(exp(-(v-vtraub-15.0)/5.0)-1.0)	b=0.5*exp(-(v-vtraub-10.0)/40.0)	tau_n = 1 / (a + b)	UNITSON}