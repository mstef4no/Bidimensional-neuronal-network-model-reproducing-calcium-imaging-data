TITLE Cortical M currentINDEPENDENT {t FROM 0 TO 1 WITH 1 (ms)}NEURON {	SUFFIX im	NONSPECIFIC_CURRENT ikk        RANGE gkbar, tauM}UNITS {	(mA) = (milliamp)	(mV) = (millivolt)}PARAMETER {	ek	= -100	(mV)	gkbar	= 3e-5	(mho/cm2)	tauM = 1000 (ms)}STATE {	m}ASSIGNED {	v	(mV)	ikk	(mA/cm2)}BREAKPOINT {	SOLVE states METHOD cnexp	ikk=gkbar*m*(v-ek)}DERIVATIVE states {  m' = (m_inf(v) - m) / tau_m(v)}INITIAL {  m = m_inf(v)}FUNCTION m_inf(v(mV)) {   UNITSOFF:  m_inf = 1/(1+exp(-(v+35)/10))   m_inf=1.0/(1.0+exp(-(v+35.0)/10.0))  UNITSON}FUNCTION tau_m(v(mV)) {   UNITSOFF:  tau_m=tauM/(3.3*exp((v+35)/20)+exp(-(v+35)/20))   tau_m=tauM/(3.3*exp((v+35.0)/20.0)+1.0*exp(-(v+35.0)/20.0))  UNITSON}