TITLE High threshold calcium currentINDEPENDENT {t FROM 0 TO 1 WITH 1 (ms)}NEURON {	SUFFIX ical	NONSPECIFIC_CURRENT ica        RANGE gcabar, eca}UNITS {	(mA) = (milliamp)	(mV) = (millivolt)}PARAMETER {	gcabar	= 1.7e-4	(mho/cm2)	eca	= 120	(mV)}STATE {	m	h}ASSIGNED {	v	(mV)	ica	(mA/cm2)}BREAKPOINT { 	SOLVE states METHOD cnexp	ica = gcabar*m*m*h*(v-eca)}DERIVATIVE states { 	m' = alpha_m(v)*(1-m)-beta_m(v)*m	h' = alpha_h(v)*(1-h)-beta_h(v)*h}INITIAL { m=alpha_m(v)/(alpha_m(v)+beta_m(v)) h=alpha_h(v)/(alpha_h(v)+beta_h(v))}FUNCTION alpha_m(v(mV)) {   LOCAL x,y  UNITSOFF:  x=(v+27):  y=3.8:  if(fabs(x/y)>1e-6){:  alpha_m = 0.055*x/(1-exp(-x/y)):  } else {:  alpha_m = 0.055*y/(1-x/(2*y)):  }  alpha_m=(0.055*(-27.0-v))/(exp((-27.0-v)/3.8)-1.0)  UNITSON}FUNCTION beta_m(v(mV)) {   UNITSOFF:  beta_m=0.94*exp((-75-v)/17) beta_m=0.94*exp((-75.0-v)/17.0)  UNITSON}FUNCTION alpha_h(v(mV)) {   UNITSOFF:  alpha_h = 0.000457*exp((-13-v)/50)  alpha_h=0.000457*exp((-13.0-v)/50.0)  UNITSON}FUNCTION beta_h(v(mV)) {   UNITSOFF:  beta_h = 0.0065/(exp((-15-v)/28) + 1)   beta_h=0.0065/(exp((-15.0-v)/28.0)+1.0)  UNITSON}